# Force JavaScript detection in frontend and backend folders
client/** linguist-language=JavaScript
server/** linguist-language=JavaScript

# Force detect all MERN-related file types
*.js linguist-detectable=true
*.jsx linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
*.html linguist-detectable=true
*.css linguist-detectable=true

# Ignore other language files (optional, for cleanup)
*.cpp linguist-documentation
*.c linguist-documentation
*.py linguist-documentation
